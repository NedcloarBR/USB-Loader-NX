{
	"format": 2,
	"keys": [
		{
			"keys": [
				"Theme.Name"
			],
			"type": "string",
			"description": "Shown in the theme picker (the folder name otherwise)"
		},
		{
			"keys": [
				"Theme.Author"
			],
			"type": "string",
			"description": "Shown in the theme picker as \"by …\""
		},
		{
			"keys": [
				"Theme.Version"
			],
			"type": "string",
			"description": "The theme's own version, whatever its author likes"
		},
		{
			"keys": [
				"Format.Version"
			],
			"type": "enum",
			"values": [
				"1",
				"2"
			],
			"default": "1",
			"description": "The version of this format the theme was made for"
		},
		{
			"keys": [
				"Images.Thumbnail"
			],
			"type": "file",
			"formats": [
				"png",
				"jpg"
			],
			"description": "The preview in the theme picker (16:9, 320x180 is enough); without it `thumb.png`, `thumb.jpg`, then the background are tried, and with none of them the picker sketches the screen in the theme's colors"
		},
		{
			"keys": [
				"Images.Background"
			],
			"type": "file",
			"formats": [
				"jpg",
				"png",
				"gif",
				"webp"
			],
			"description": "Drawn behind everything, over the `Ground` color. An animated GIF or WebP plays in a loop: up to 1280x720, 30 frames a second at most and 32 MB; WebP looks better and weighs less than GIF (256 colors)"
		},
		{
			"keys": [
				"Images.BackgroundMode"
			],
			"type": "enum",
			"values": [
				"stretch",
				"tile"
			],
			"default": "stretch",
			"description": "How the background fills the screen"
		},
		{
			"keys": [
				"Images.BackgroundDim"
			],
			"type": "number",
			"min": 0,
			"max": 0.9,
			"default": 0.4,
			"description": "How much of `Ground` covers the background image so text stays readable; over an image, the text areas also get a veil of `Ground`"
		},
		{
			"keys": [
				"Images.Panel",
				"Images.Card",
				"Images.CardFocused",
				"Images.Chip",
				"Images.Button",
				"Images.ButtonActive",
				"Images.FocusRing"
			],
			"type": "file",
			"formats": [
				"png"
			],
			"description": "PNGs in place of windows, cards (and the focused one), the small chips, buttons (and the one A presses) and the focus ring; stretched in nine slices, so their corners keep their size"
		},
		{
			"keys": [
				"Images.PanelBorder",
				"Images.CardBorder",
				"Images.CardFocusedBorder",
				"Images.ChipBorder",
				"Images.ButtonBorder",
				"Images.ButtonActiveBorder",
				"Images.FocusRingBorder"
			],
			"type": "number",
			"min": 0,
			"max": 256,
			"default": 16,
			"description": "How wide those corners are, in the image's px"
		},
		{
			"keys": [
				"Images.Icon.Usb",
				"Images.Icon.Clock",
				"Images.Icon.Warning",
				"Images.Icon.Chevron",
				"Images.Icon.Star",
				"Images.Icon.Package",
				"Images.Icon.Grid"
			],
			"type": "file",
			"formats": [
				"png"
			],
			"description": "PNGs in place of the built-in icons"
		},
		{
			"keys": [
				"Images.IconTint"
			],
			"type": "enum",
			"values": [
				"on",
				"off"
			],
			"default": "off",
			"description": "`on`: icons and the focus ring image take the color they are drawn in (draw them white); otherwise they keep their own"
		},
		{
			"keys": [
				"Images.GameBackdrop"
			],
			"type": "enum",
			"values": [
				"on",
				"off"
			],
			"default": "on",
			"description": "The selected game's cover or icon, blurred, behind the home screen (the player can turn it off too); on by default unless the theme has its own `Images.Background`"
		},
		{
			"keys": [
				"Fonts.Regular"
			],
			"type": "file",
			"formats": [
				"ttf",
				"otf"
			],
			"description": "A TTF or OTF (up to 16 MB) for all the text; letters it lacks (other scripts, button glyphs) come from the console's font"
		},
		{
			"keys": [
				"Fonts.Scale"
			],
			"type": "number",
			"min": 0.8,
			"max": 1.25,
			"default": 1,
			"description": "The font's size against the console's"
		},
		{
			"keys": [
				"Sounds.Music"
			],
			"type": "file",
			"formats": [
				"ogg",
				"mp3",
				"wav"
			],
			"description": "Background music, under the sound effects; the player can turn it off in the settings"
		},
		{
			"keys": [
				"Animations.Speed"
			],
			"type": "number",
			"min": 0.25,
			"max": 4,
			"default": 1,
			"description": "How fast transitions run (`1` as designed)"
		},
		{
			"keys": [
				"Animations.Floating"
			],
			"type": "enum",
			"values": [
				"on",
				"off"
			],
			"default": "on",
			"description": "`off` keeps covers and icons still"
		},
		{
			"keys": [
				"Animations.Particles"
			],
			"type": "enum",
			"values": [
				"on",
				"off"
			],
			"default": "on",
			"description": "`off` removes the drifting specks"
		},
		{
			"keys": [
				"Animations.Easing"
			],
			"type": "enum",
			"values": [
				"out-cubic",
				"linear",
				"out-quad",
				"in-out-sine",
				"out-back",
				"out-elastic"
			],
			"default": "out-cubic",
			"description": "How transitions move (`out-back` goes a little past and settles, `out-elastic` springs)"
		},
		{
			"keys": [
				"Animations.FocusPulse"
			],
			"type": "number",
			"min": 0.5,
			"max": 6,
			"default": 1.6,
			"also": [
				"off"
			],
			"description": "Seconds for the focus ring to go from `Focus` to `FocusAlt` and back; `off` keeps it still"
		}
	],
	"layoutKeys": [
