			"default": "top-left",
			"description": "The screen's point the component's own same point sits at"
		},
		{
			"keys": [
				"X"
			],
			"type": "number",
			"min": -1280,
			"max": 1280,
			"default": 0,
			"description": "The offset from that point (without `Anchor`, from the screen's top left); without `X`, `Y` or `Anchor` the component stays where the Manager puts it"
		},
		{
			"keys": [
				"Y"
			],
			"type": "number",
			"min": -720,
			"max": 720,
			"default": 0,
