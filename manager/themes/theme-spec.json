	"componentProperties": [
		{
			"keys": [
				"Anchor"
			],
			"type": "enum",
			"values": [
				"top-left",
				"top",
				"top-right",
				"left",
				"center",
				"right",
				"bottom-left",
				"bottom",
				"bottom-right"
